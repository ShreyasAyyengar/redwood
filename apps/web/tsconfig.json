{
  "extends": "@redwood/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@backend/*": ["../backend/*"]
    },
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,
    "types": ["bun"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
